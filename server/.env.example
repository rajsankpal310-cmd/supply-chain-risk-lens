# NEXUS-CFR Backend Environment Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# Local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexuscfr?schema=public"
# Neon Serverless PostgreSQL (Recommended):
# DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Other Hosted PostgreSQL (Render, Railway, AWS RDS, Supabase):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# JWT Authentication
JWT_SECRET="nexus_cfr_super_secret_jwt_key_2026_prod"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:8080"
